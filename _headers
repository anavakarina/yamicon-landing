# Кэширование шрифтов
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Кэширование картинок
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Кэширование CSS и JS
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable